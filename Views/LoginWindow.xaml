<Window x:Class="SmartSaving.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize"
        SizeToContent="Height"
>

    <Grid Margin="20">
        <!-- ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#FF34495E" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Bienvenido" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                   <TextBlock Text="Email" />
                   <TextBox Height="30"
                     Margin="0,5,0,10"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                   <TextBlock Text="Password" />
                   <PasswordBox Height="30"
                         Margin="0,5,0,20"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

                    <Button Content="Login"
                    Height="35"
                    Command="{Binding LoginCommand}" />

                    <!-- Crear cuenta -->
                    <TextBlock Text="Crear cuenta" Foreground="#FF3498DB" 
                               HorizontalAlignment="Center" Margin="0,15,0,0" 
                               Cursor="Hand"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>