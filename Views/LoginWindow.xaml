<Window x:Class="SmartSaving.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize"
        SizeToContent="Height"
>

    <Grid Margin="20">
        <!-- ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#FF34495E" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Bienvenido" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Email -->
                    <TextBlock Text="Email" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1" />

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,20"
                                 Padding="5" Background="#FFECF0F1" />

                    <!-- Botón Login -->
                    <Button Content="Iniciar Sesión" Height="35" Background="#FF1ABC9C"
                            Foreground="White" FontWeight="Bold"
                            Cursor="Hand"/>

                    <!-- Crear cuenta -->
                    <TextBlock Text="Crear cuenta" Foreground="#FF3498DB" 
                               HorizontalAlignment="Center" Margin="0,15,0,0" 
                               Cursor="Hand"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>