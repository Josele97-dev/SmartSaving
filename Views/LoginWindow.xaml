<Window x:Class="SmartSaving.Views.LoginWindow"
	   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	   Title="Iniciar Sesión" Height="500" Width="400"
	   WindowStartupLocation="CenterScreen"
	   Background="#FF2C3E50"
	   ResizeMode="NoResize"
	   SizeToContent="Height">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Border Background="#FF34495E" CornerRadius="10" Padding="20">
				<StackPanel VerticalAlignment="Center">


                    <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="40"
                                   Foreground="#FF1ABC9C"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                    <!-- Title -->
					<TextBlock Text="Bienvenido"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

					<!-- Error Message -->
					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFE74C3C"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Visibility="Visible"/>

					<TextBlock Text="Email" Foreground="White"/>
					<TextBox Height="30"
                             Padding="5"
                             Background="#FFECF0F1"
                             Margin="0,5,0,10"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Text="Password" Foreground="White" />
					<PasswordBox Height="30"
                                 Padding="5"
                                 Background="#FFECF0F1"
                                 Margin="0,5,0,20"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

					<Button Content="Login"
                            Height="35"
                            Background="#FF1ABC9C"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding LoginCommand}" />

					<!-- Create account link -->
					<TextBlock Text="Crear cuenta"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               FontWeight="Bold"
                               Cursor="Hand">
						<TextBlock.InputBindings>
							<MouseBinding Gesture="LeftClick"
                                          Command="{Binding OpenRegisterCommand}" />
						</TextBlock.InputBindings>
					</TextBlock>

				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>
