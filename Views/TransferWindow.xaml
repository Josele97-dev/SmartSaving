<Window x:Class="SmartSaving.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaving.Views"
        mc:Ignorable="d"
        Title="Transfer Funds" Height="450" Width="800">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <StackPanel Background="Transparent">

                <!-- Title -->
                <TextBlock Text="Transfer Funds"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="#334155" CornerRadius="12" Padding="20">
                    <StackPanel>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFE74C3C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Recipient -->
                        <TextBlock Text="Send To" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox Background="#FFECF0F1"
                                  Padding="5"
                                  Margin="0,0,0,15"
                                  ItemsSource="{Binding AvailableRecipients}"
                                  SelectedItem="{Binding SelectedRecipient}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="Black">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="FirstName"/>
                                                <Binding Path="LastName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Amount -->
                        <TextBlock Text="Amount" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Background="#FFECF0F1"
                                 Padding="5"
                                 Margin="0,0,0,15"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Description -->
                        <TextBlock Text="Description (optional)" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Background="#FFECF0F1"
                                 Padding="5"
                                 Margin="0,0,0,20"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Transfer Button -->
                        <Button Content="Transfer"
                                Height="35"
                                Background="#FF1ABC9C"
                                Foreground="White"
                                FontWeight="Bold"
                                Command="{Binding TransferCommand}"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</Window>
