<Window x:Class="SmartSaving.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaving.Views"
        mc:Ignorable="d"
        Title="Transfer Funds" Height="450" Width="800"
        Icon="/Assets/Icono.ico">
    
    <Grid Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#334155">
            <StackPanel Background="#334155">

                <TextBlock Text="Transfer Funds"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,5,15"/>

                <TextBlock Text="&#xe8e6;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="40"
                           Foreground="#CCF221"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Border Background="#334155" CornerRadius="12" Padding="20">
                    <StackPanel Background="Transparent">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFE74C3C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <Border Background="#1E3A4A" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Available Balance: "
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentBalance, StringFormat='€{0:N2}'}"
                                           Foreground="#FF1ABC9C"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Send To" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox Background="#FFECF0F1"
                                  Padding="5"
                                  Margin="0,0,0,15"
                                  ItemsSource="{Binding AvailableRecipients}"
                                  SelectedItem="{Binding SelectedRecipient}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="Black">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="FirstName"/>
                                                <Binding Path="LastName"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Amount" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Background="#FFECF0F1"
                                 Padding="5"
                                 Margin="0,0,0,15"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Description (optional)" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Background="#FFECF0F1"
                                 Padding="5"
                                 Margin="0,0,0,20"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="e.g. Regalo Cumple, Cena, Deuda..."
                                                                       Foreground="#FF999999"
                                                                       FontStyle="Italic"
                                                                       Margin="6,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Content="Transfer"
                                Height="35"
                                Background="#FF1ABC9C"
                                Foreground="White"
                                FontWeight="Bold"
                                Command="{Binding TransferCommand}"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</Window>
