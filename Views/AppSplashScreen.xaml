<Window x:Class="SmartSaving.Views.AppSplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="380" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            
            <Border CornerRadius="1000"
            Width="300"
            Height="300"
            ClipToBounds="True"
            Margin="0,0,0,15"
            HorizontalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/SmartSaving_Splash.jpg"
                    Stretch="Uniform"/>
                </Border.Background>
            </Border>

            <TextBlock Text="Your beloved personal wallet, now simplified."
                       Foreground="#FFF0F0F0"
                       FontSize="18"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>