<Window x:Class="SmartSaving.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Welcome Message -->
				<TextBlock Text="{Binding WelcomeMessage}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

				<!-- Balance Card -->
				<Border Background="#FF34495E" CornerRadius="10" Padding="20" Margin="0,0,0,15">
					<StackPanel>
						<TextBlock Text="Current Balance"
                                   Foreground="#FFBDC3C7"
                                   FontSize="14"/>
						<TextBlock Text="{Binding Balance, StringFormat='€{0:N2}'}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"/>
					</StackPanel>
				</Border>

				<!-- Income / Expenses Summary -->
				<Grid Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Income -->
					<Border Grid.Column="0" Background="#FF27AE60" CornerRadius="8" Padding="15">
						<StackPanel>
							<TextBlock Text="Income" Foreground="White" FontSize="12"/>
							<TextBlock Text="{Binding TotalIncome, StringFormat='€{0:N2}'}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
						</StackPanel>
					</Border>

					<!-- Expenses -->
					<Border Grid.Column="2" Background="#FFE74C3C" CornerRadius="8" Padding="15">
						<StackPanel>
							<TextBlock Text="Expenses" Foreground="White" FontSize="12"/>
							<TextBlock Text="{Binding TotalExpenses, StringFormat='€{0:N2}'}"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,5,0,0"/>
						</StackPanel>
					</Border>
				</Grid>

				<!-- Recent Transactions -->
				<TextBlock Text="Recent Transactions"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<Border Background="#FF34495E" CornerRadius="8" Padding="5" MinHeight="120">
					<ListView ItemsSource="{Binding RecentTransactions}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White">
						<ListView.View>
							<GridView>
								<GridViewColumn Header="Date" Width="90"
                                                DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
								<GridViewColumn Header="Description" Width="150"
                                                DisplayMemberBinding="{Binding Description}"/>
								<GridViewColumn Header="Amount" Width="100"
                                                DisplayMemberBinding="{Binding Amount, StringFormat='€{0:N2}'}"/>
							</GridView>
						</ListView.View>
					</ListView>
				</Border>

				<!-- Buttons -->
				<Grid Margin="0,15,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0"
                            Content="New Transaction"
                            Height="35"
                            Background="#FF1ABC9C"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding OpenTransactionCommand}" />

					<Button Grid.Column="2"
                            Content="Refresh"
                            Height="35"
                            Width="80"
                            Background="#FF3498DB"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding RefreshCommand}" />
				</Grid>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
