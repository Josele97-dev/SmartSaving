<Window x:Class="SmartSaving.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Welcome Message -->
				<TextBlock Text="{Binding WelcomeMessage}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

				<!-- Balance Card -->
                <Button Command="{Binding SearchCommand}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Border Background="#FF34495E" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Current Balance"
                       Foreground="#FFBDC3C7"
                       FontSize="14"/>
                            <TextBlock Text="{Binding Balance, StringFormat='€{0:N2}'}"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>

                <TextBlock Text="{Binding TransferBanner}"
                   Foreground="#FF27AE60"
                   FontSize="12"
                   FontWeight="Bold"
                   FontStyle="Normal"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"
                   Visibility="{Binding ShowTransferBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Income / Expenses Summary -->
				<Grid Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Income -->
                    <Button Grid.Column="0"  Command="{Binding ViewMonthlyCommand}" Cursor="Hand"
						BorderThickness="0" Background="Transparent" Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Border Background="#FF27AE60" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Income" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding TotalIncome, StringFormat='€{0:N2}'}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- Expenses -->
                    <Button Grid.Column="2" Command="{Binding ViewMonthlyCommand}" Cursor="Hand"
					 BorderThickness="0" Background="Transparent" Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Border Background="#FFE74C3C" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Expenses" Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding TotalExpenses, StringFormat='€{0:N2}'}"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
                <Button Content="Transfer Funds"
                Height="35"
                Margin="0,0,0,15"
                Background="#FF1ABC9C"
                Foreground="White"
                FontWeight="Bold"
                Command="{Binding TransferCommand}"/>

                <Button Content="Transfer Record"
                Height="25"
                Margin="0,5,0,0"
                Background="#FF2980B9"
                Foreground="White"
                FontWeight="Bold"
                Command="{Binding TransfersRecordCommand}"/>

                <TextBlock Text="This Month"
           Foreground="White"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,10"/>

				<Border Background="#FF34495E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Monthly Income -->
						<StackPanel Grid.Column="0" HorizontalAlignment="Center">
							<TextBlock Text="Income"
									   Foreground="#FFBDC3C7"
									   FontSize="12"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="{Binding MonthlyIncome, StringFormat='€{0:N2}'}"
									   Foreground="#FF27AE60"
									   FontSize="15"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Margin="0,4,0,0"/>
						</StackPanel>

						<!-- Monthly Expenses -->
						<StackPanel Grid.Column="1" HorizontalAlignment="Center">
							<TextBlock Text="Expenses"
									   Foreground="#FFBDC3C7"
									   FontSize="12"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="{Binding MonthlyExpenses, StringFormat='€{0:N2}'}"
									   Foreground="#FFE74C3C"
									   FontSize="15"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Margin="0,4,0,0"/>
						</StackPanel>

						<!-- Monthly Net -->
						<StackPanel Grid.Column="2" HorizontalAlignment="Center">
							<TextBlock Text="Net"
									   Foreground="#FFBDC3C7"
									   FontSize="12"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="{Binding MonthlyNet, StringFormat='€{0:N2}'}"
									   Foreground="{Binding MonthlyNetColour}"
									   FontSize="15"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Margin="0,4,0,0"/>
						</StackPanel>

					</Grid>
				</Border>
				
                <TextBlock Text="Budget Progress"
           Foreground="White"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,10"/>

                <Border Background="#FF34495E" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding CategoryProgress}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Summary}"
                               Foreground="White"
                               FontSize="13"
                               Margin="0,0,0,4"/>
                                    <Grid Height="12">
                                        <Border Background="#FF1A2F3E" CornerRadius="6"/>
                                        <Border CornerRadius="6"
                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <Binding Path="Percentage"
                                         Converter="{StaticResource PercentageToWidthConverter}"/>
                                            </Border.Width>
                                            <Border.Background>
                                                <Binding Path="ProgressColour"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                
                <!-- Recent Transactions -->
				<Grid Margin="0,0,0,10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="Recent Transactions"
								   Foreground="White"
								   FontSize="16"
								   FontWeight="Bold"
								   VerticalAlignment="Center"/>
						<Border Background="#FF3498DB"
								CornerRadius="10"
								Padding="6,2"
								Margin="8,0,0,0"
								VerticalAlignment="Center">
							<TextBlock Text="{Binding MonthlyTransactionCount}"
									   Foreground="White"
									   FontSize="11"
									   FontWeight="Bold"/>
						</Border>
					</StackPanel>

					<Button Grid.Column="1"
							Content="View All"
							Height="28"
							Width="70"
							Background="#FF8E44AD"
							Foreground="White"
							FontWeight="Bold"
							Command="{Binding ViewMonthlyCommand}"/>

					<Button Grid.Column="3"
							Content="Search"
							Height="28"
							Width="70"
							Background="#FF3498DB"
							Foreground="White"
							FontWeight="Bold"
							Command="{Binding SearchCommand}"/>
				</Grid>

				<Border Background="#FF34495E" CornerRadius="8" Padding="5" MinHeight="120">
					<Grid>
						<ListView ItemsSource="{Binding RecentTransactions}"
								  Background="Transparent"
								  BorderThickness="0"
								  Foreground="White"
								  SelectedItem="{Binding SelectedTransaction}"
								  MouseDoubleClick="ListView_MouseDoubleClick">
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Style.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="#FF1A2F3E"/>
											<Setter Property="Foreground" Value="White"/>
										</Trigger>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="#FF2A4A5E"/>
											<Setter Property="Foreground" Value="White"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.View>
								<GridView>
									<GridViewColumn Header="Date" Width="90"
													DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
									<GridViewColumn Header="Description" Width="150"
													DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Amount" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TransactionAmountConverter}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
							</ListView.View>
						</ListView>
						<TextBlock Text="No transactions yet — add your first one!"
								   Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVisibilityConverter}}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Foreground="#FFBDC3C7"
								   FontStyle="Italic"
								   FontSize="13"/>
					</Grid>
				</Border>
				<!-- Buttons -->
				<Grid Margin="0,15,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Button Content="New Transaction"
                            Height="35"
                            Background="#FF1ABC9C"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding OpenTransactionCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Button Content="Refresh"
                        Height="35"
                        Width="80"
                        Background="#FF3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding RefreshCommand}" />
                        <TextBlock Text="{Binding LastRefreshedText}"
                           Foreground="#FFBDC3C7"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                
                <Button Grid.Column="4"
                Content="Manage Categories"
                Height="35"
                Margin="0,10,0,0"
                Background="#FF8E44AD"
                Foreground="White"
                 FontWeight="Bold"
                Command="{Binding ManageCategoriesCommand}"/>  
                
                <Button Content="Logout"
                Height="20"
                 Margin="0,10,0,0"
                 Background="#FFE74C3C"
                 Foreground="White"
                 FontWeight="Bold"
                 Command="{Binding LogoutCommand}" />
            </StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
