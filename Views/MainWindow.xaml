<Window x:Class="SmartSaving.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="300" Width="400">

	<Grid Margin="20">
		<StackPanel>

			<TextBlock Text="Current Balance"
                       FontWeight="Bold"
                       FontSize="16"/>

			<TextBlock Text="{Binding Balance}"
                       FontSize="20"
                       Margin="0,10,0,20"/>

			<Button Content="New Transaction"
                    Height="35"
                    Command="{Binding OpenTransactionCommand}" />

		</StackPanel>
	</Grid>
</Window>
