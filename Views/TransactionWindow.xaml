<Window x:Class="SmartSaving.Views.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Movimiento" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#334155" CornerRadius="12" Padding="20">
				<StackPanel>

					<TextBlock Text="Transaction Type" />
					<ComboBox Margin="0,5,0,10"
							  ItemsSource="{Binding TransactionTypes}"
							  SelectedItem="{Binding SelectedTransactionType}" />

					<TextBlock Text="Amount" />
					<TextBox Margin="0,5,0,20"
							 Text="{Binding Amount}" />

					<Button Content="Save"
							Height="35"
							Command="{Binding SaveTransactionCommand}" />

				</StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>