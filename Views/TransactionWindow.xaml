<Window x:Class="SmartSaving.Views.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- Form Card -->
				<Border Background="#334155" CornerRadius="12" Padding="20" Margin="0,0,0,15">
					<StackPanel>

						<!-- Title -->
						<TextBlock Text="{Binding Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

						<!-- Error Message -->
						<TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFE74C3C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Visibility="Visible"/>

						<!-- Transaction Type -->
						<TextBlock Text="Transaction Type" Foreground="White" />
						<ComboBox Margin="0,5,0,10"
                                  Background="#FFECF0F1"
                                  Padding="5"
                                  ItemsSource="{Binding TransactionTypes}"
                                  SelectedItem="{Binding SelectedTransactionType}" />

						<!-- Description -->
						<TextBlock Text="Description" Foreground="White" />
						<TextBox Margin="0,5,0,10"
                                 Background="#FFECF0F1"
                                 Padding="5"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

						<!-- Amount -->
						<TextBlock Text="Amount" Foreground="White" />
						<TextBox Margin="0,5,0,10"
                                 Background="#FFECF0F1"
                                 Padding="5"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

						<!-- Date -->
						<TextBlock Text="Date" Foreground="White" />
						<DatePicker Margin="0,5,0,10"
                                    Background="#FFECF0F1"
                                    Padding="5"
                                    SelectedDate="{Binding Date}" />

						<!-- Category (if categories are available) -->
						<TextBlock Text="Category" Foreground="White" />
                        <ComboBox Margin="0,5,0,20"
          Background="#FFECF0F1"
          Padding="5"
          ItemsSource="{Binding Categories}"
          SelectedValuePath="Id"
          SelectedValue="{Binding CategoryId}">
                        <ComboBox.ItemTemplate>
                        <DataTemplate>
                         <TextBlock Text="{Binding Title}" Foreground="Black"/>
                        </DataTemplate>
                        </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Save Button -->
						<Button Content="Save"
                                Height="35"
                                Background="#FF1ABC9C"
                                Foreground="White"
                                FontWeight="Bold"
                                Command="{Binding SaveCommand}" />

					</StackPanel>
				</Border>

				<!-- Transaction History -->
				<TextBlock Text="Transaction History"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<Border Background="#334155" CornerRadius="8" Padding="5" MinHeight="100">
					<ListView ItemsSource="{Binding Transactions}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White">
						<ListView.View>
							<GridView>
								<GridViewColumn Header="Date" Width="85"
                                                DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
								<GridViewColumn Header="Description" Width="130"
                                                DisplayMemberBinding="{Binding Description}"/>
								<GridViewColumn Header="Amount" Width="90"
                                                DisplayMemberBinding="{Binding Amount, StringFormat='€{0:N2}'}"/>
							</GridView>
						</ListView.View>
					</ListView>
				</Border>

				<!-- Refresh Button -->
				<Button Content="Refresh"
                        Height="30"
                        Margin="0,10,0,0"
                        Background="#FF3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding RefreshCommand}" />

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
