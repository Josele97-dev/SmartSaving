<Window x:Class="SmartSaving.Views.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize"
        Icon="/Assets/Icono.ico">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				
				<Border Background="#334155" CornerRadius="12" Padding="20" Margin="0,0,0,15">
					<StackPanel>

						
						<TextBlock Text="{Binding Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

						
						<TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FFE74C3C"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Visibility="Visible"/>

						
						<TextBlock Text="Transaction Type" Foreground="White" />
						<ComboBox Margin="0,5,0,10"
                                  Background="#FFECF0F1"
                                  Padding="5"
                                  ItemsSource="{Binding TransactionTypes}"
                                  SelectedItem="{Binding SelectedTransactionType}" />

						
						<TextBlock Text="Description" Foreground="White" />
						<TextBox Margin="0,5,0,10"
                                 Background="#FFECF0F1"
                                 Padding="5"
                                 IsEnabled="{Binding IsEditableTransaction}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

						
						<TextBlock Text="Amount" Foreground="White" />
                        <TextBox Margin="0,5,0,10"
                         Padding="5"
                         IsEnabled="{Binding IsNotEditing}"
                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged,TargetNullValue=0, FallbackValue=0}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FFECF0F1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFE74C3C"/>
                                            <Setter Property="Background" Value="#FFFDEDEC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        
						<TextBlock Text="Date" Foreground="White" />
						<DatePicker Margin="0,5,0,10"
                                    Background="#FFECF0F1"
                                    Padding="5"
                                    IsEnabled="{Binding IsNotEditing}"
                                    SelectedDate="{Binding Date}" />

						
						<TextBlock Text="Category" Foreground="White" />
                        <ComboBox Margin="0,5,0,20"
                          Background="#FFECF0F1"
                          Padding="5"
                          IsEnabled="{Binding IsEditableTransaction}"
                          ItemsSource="{Binding FilteredCategories}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding CategoryId}">
                         <ComboBox.ItemTemplate>
                        <DataTemplate>
                         <TextBlock Text="{Binding Title}" Foreground="Black"/>
                        </DataTemplate>
                        </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Monthly Budget Limit (leave empty for no limit)" 
                       Foreground="White" 
                       Margin="0,5,0,0"
                       Visibility="{Binding IsExpenseType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBox Margin="0,5,0,20"
                         Background="#FFECF0F1"
                         Padding="5"
                         Text="{Binding BudgetLimit, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsExpenseType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Content="Save Limit"
                        Height="25"
                        Margin="0,0,0,5"
                        Background="DeepSkyBlue"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsExpenseType, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        
                        <Button Content="Save Transaction"
                        Height="35"
                        Margin="0,20,0,0"
                        Background="#FF1ABC9C"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsEditableTransaction, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    </StackPanel>
				</Border>

				
				<TextBlock Text="Transaction History"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<Border Background="#334155" CornerRadius="8" Padding="5" MinHeight="100">
					<Grid>
						<ListView ItemsSource="{Binding Transactions}"
								  Background="Transparent"
								  BorderThickness="0"
								  Foreground="White">
							<ListView.ItemContainerStyle>
								<Style TargetType="ListViewItem">
									<Style.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="#FF1A2F3E"/>
											<Setter Property="Foreground" Value="White"/>
										</Trigger>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="#FF2A4A5E"/>
											<Setter Property="Foreground" Value="White"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</ListView.ItemContainerStyle>
							<ListView.View>
								<GridView>
									<GridViewColumn Header="Date" Width="85"
													DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
									<GridViewColumn Header="Description" Width="130"
													DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Amount" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource TransactionAmountConverter}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
							</ListView.View>
						</ListView>
						<TextBlock Text="No transactions yet — your history will appear here."
								   Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVisibilityConverter}}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   Foreground="#FFBDC3C7"
								   FontStyle="Italic"
								   FontSize="13"/>
					</Grid>
				</Border>

				
				<Button Content="Refresh"
                        Height="30"
                        Margin="0,10,0,0"
                        Background="#FF3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding RefreshCommand}" />

			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
