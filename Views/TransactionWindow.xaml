<Window x:Class="SmartSaving.Views.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Movimiento" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#334155" CornerRadius="12" Padding="20">
                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Nuevo Movimiento"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#F1F5F9"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Tipo -->
                    <TextBlock Text="Tipo de movimiento" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                    <ComboBox Height="30"
                              Margin="0,0,0,10"
                              Background="#F8FAFC"
                              BorderThickness="0"
                              ItemsSource="{Binding Types}"
                              SelectedItem="{Binding Type}"/>

                    <!-- Cantidad -->
                    <TextBlock Text="Cantidad" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Height="30"
                                 Padding="5"
                                 Background="#F8FAFC"
                                 BorderThickness="0"
                                 Grid.Column="0"
                                 Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Grid.Column="1"
                                Background="#E2E8F0"
                                CornerRadius="0,4,4,0">
                            <TextBlock Text="€"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"/>
                        </Border>
                    </Grid>

                    <!-- Categoría -->
                    <TextBlock Text="Categoría" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                    <TextBox Height="30"
                             Margin="0,0,0,10"
                             Padding="5"
                             Background="#F8FAFC"
                             BorderThickness="0"
                             Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Descripción -->
                    <TextBlock Text="Descripción" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                    <TextBox Height="60"
                             Margin="0,0,0,10"
                             Padding="5"
                             Background="#F8FAFC"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Fecha -->
                    <TextBlock Text="Fecha" Foreground="#E2E8F0" Margin="0,0,0,5"/>
                    <DatePicker Height="30"
                                Margin="0,0,0,20"
                                Background="#F8FAFC"
                                BorderThickness="0"
                                SelectedDate="{Binding Date}"/>

                    <!-- Botón -->
                    <Button Content="Guardar Movimiento"
                            Height="35"
                            Background="#6366F1"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding SaveCommand}"/>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>