<Window x:Class="SmartSaving.Views.MonthlyTransactionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="This Month" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize"
        Icon="/Assets/Icono.ico">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="Transparent">
            <StackPanel Background="Transparent">

                
                <TextBlock Text="{Binding MonthTitle}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                
                <StackPanel Orientation="Horizontal" Margin="5,0,0,10">

                    <TextBlock Text="Income"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
                    <TextBlock Text="&#xe74c;"
                 FontFamily="Segoe MDL2 Assets"
                 FontSize="16"
                 Foreground="Green"
                 VerticalAlignment="Center"
                 Margin="5,0,0,0"  />
                </StackPanel>

                <Border Background="#1A3A2A" CornerRadius="8" Padding="5" MinHeight="80" Margin="0,0,0,20">
                    <Grid>
                        <ListView ItemsSource="{Binding IncomeTransactions}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  SelectedItem="{Binding SelectedTransaction}"
                                  MouseDoubleClick="ListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF1A2F3E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2A4A5E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="90"
                                                    DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                    <GridViewColumn Header="Description" Width="180"
                                                    DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Amount" Width="100"
                                                    DisplayMemberBinding="{Binding Amount, StringFormat='€{0:N2}'}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="No income recorded this month."
                                   Visibility="{Binding HasNoIncome, Converter={StaticResource BoolToVisibilityConverter}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFBDC3C7"
                                   FontStyle="Italic"
                                   FontSize="13"/>
                    </Grid>
                </Border>

                
                <StackPanel Orientation="Horizontal" Margin="5,0,0,10">

                    <TextBlock Text="Expenses"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                VerticalAlignment="Center"/>
                    <TextBlock Text="&#xe8d0;"
                 FontFamily="Segoe MDL2 Assets"
                 FontSize="16"
                 Foreground="Red"
                 VerticalAlignment="Center"
                 Margin="5,0,0,0"  />
                </StackPanel>

                <Border Background="#3A1A1A" CornerRadius="8" Padding="5" MinHeight="80" Margin="0,0,0,20">
                    <Grid>
                        <ListView ItemsSource="{Binding ExpenseTransactions}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  SelectedItem="{Binding SelectedTransaction}"
                                  MouseDoubleClick="ListView_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF1A2F3E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2A4A5E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="90"
                                                    DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                    <GridViewColumn Header="Description" Width="180"
                                                    DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Amount" Width="100"
                                                    DisplayMemberBinding="{Binding Amount, StringFormat='€{0:N2}'}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="No expenses recorded this month."
                                   Visibility="{Binding HasNoExpenses, Converter={StaticResource BoolToVisibilityConverter}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFBDC3C7"
                                   FontStyle="Italic"
                                   FontSize="13"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
