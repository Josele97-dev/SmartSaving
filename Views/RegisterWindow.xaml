<Window x:Class="SmartSaving.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Cuenta" Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#FF34495E" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Crear Cuenta" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNombre" Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1" />

                    <!-- Apellidos -->
                    <TextBlock Text="Apellidos" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtApellidos" Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1" />

                    <!-- Email -->
                    <TextBlock Text="Email" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1" />

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,20"
                                 Padding="5" Background="#FFECF0F1" />
                    
                    

                    <!-- Botón Crear Cuenta -->
                    <Button Content="Crear Cuenta" Height="35" Background="#FF1ABC9C"
                            Foreground="White" FontWeight="Bold"
                            Cursor="Hand"/>
                   

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
