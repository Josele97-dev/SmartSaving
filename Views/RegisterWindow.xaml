<Window x:Class="SmartSaving.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Cuenta" Height="560" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#FF34495E" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <!-- Título -->
                    <TextBlock Text="Crear Cuenta" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <!-- Nombre -->
                    <TextBlock Text="Nombre" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Apellidos -->
                    <TextBlock Text="Apellidos" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Email -->
                    <TextBlock Text="Email" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox Height="30" Margin="0,0,0,10"
                             Padding="5" Background="#FFECF0F1"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,10"
                                 Padding="5" Background="#FFECF0F1"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                    <!-- Confirmar Contraseña -->
                    <TextBlock Text="Confirmar Contraseña" Foreground="White" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtConfirmPassword" Height="30" Margin="0,0,0,20"
                                 Padding="5" Background="#FFECF0F1"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                    <!-- Botón Crear Cuenta -->
                    <Button Content="Crear Cuenta" Height="35" Background="#FF1ABC9C"
                            Foreground="White" FontWeight="Bold"
                            Cursor="Hand"
                            Command="{Binding RegisterCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>