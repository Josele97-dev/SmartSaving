<Window x:Class="SmartSaving.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Cuenta" Height="650" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize"
        Icon="/Assets/Icono.ico">

	<Grid Margin="20">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<Border Background="#FF34495E" CornerRadius="10" Padding="20">
				<StackPanel VerticalAlignment="Center">

					
					<TextBlock Text="Create account"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="&#xe71d;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="40"
                                   Foreground="#FF1ABC9C"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                    
					<TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FFE74C3C"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Visibility="Visible"/>

					
					<TextBlock Text="First Name" Foreground="White" />
					<TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,10"
                             Padding="5"
                             Background="#FFECF0F1"/>

					
					<TextBlock Text="Last Name" Foreground="White" />
					<TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,10"
                             Padding="5"
                             Background="#FFECF0F1"/>

					
					<TextBlock Text="Email" Foreground="White" />
					<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,5,0,10"
                             Padding="5"
                             Background="#FFECF0F1"/>

					
					<TextBlock Text="Password" Foreground="White" />
					<PasswordBox Margin="0,5,0,10"
                                 Padding="5"
                                 Background="#FFECF0F1"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

					
					<TextBlock Text="Confirm Password" Foreground="White" />
					<PasswordBox Margin="0,5,0,20"
                                 Padding="5"
                                 Background="#FFECF0F1"
                                 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

					<Button Content="Register"
                            Height="35"
                            Background="#FF1ABC9C"
                            Foreground="White"
                            FontWeight="Bold"
                            Command="{Binding RegisterCommand}" />

					
					<TextBlock Text="Back to Login"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Margin="0,15,0,0"
                               Cursor="Hand">
						<TextBlock.InputBindings>
							<MouseBinding Gesture="LeftClick"
                                          Command="{Binding OpenLoginCommand}" />
						</TextBlock.InputBindings>
					</TextBlock>

				</StackPanel>
			</Border>
		</ScrollViewer>
	</Grid>
</Window>
