<Window x:Class="SmartSaving.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear Cuenta" Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF2C3E50"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="#FF34495E" CornerRadius="10" Padding="20">
                <StackPanel VerticalAlignment="Center">

                    <!-- Título -->
                    <TextBlock Text="Crear Cuenta" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Nombre -->
					<TextBlock Text="Username" />
					<TextBox Text="{Binding Username}" Margin="0,5,0,10"/>

					<TextBlock Text="Password" />
					<PasswordBox Margin="0,5,0,10"
								 PasswordChanged="PasswordBox_PasswordChanged"/>

					<TextBlock Text="Confirm Password" />
					<PasswordBox Margin="0,5,0,20"
								 PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>

					<Button Content="Register"
							Height="35"
							Command="{Binding RegisterCommand}" />
                   

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
