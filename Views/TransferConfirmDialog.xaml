<Window x:Class="SmartSaving.Views.TransferConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSaving.Views"
        mc:Ignorable="d"
        Title="TransferConfirmDialog" Height="450" Width="800"
        Icon="/Assets/Icono.ico">
     
    <Grid Margin="0">
        <StackPanel Background="#334155">
            
            
            <StackPanel x:Name="ConfirmContent" Background="Transparent">
                <TextBlock Text="Confirm Transfer"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>
                
                <TextBlock Text="&#xe91c;"
               FontFamily="Segoe MDL2 Assets"
               FontSize="25"
               Foreground="#E23247"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

                <TextBlock x:Name="MessageText"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
                
                <TextBlock x:Name="ErrorText"
                   Foreground="#FFE74C3C"
                   FontSize="12"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,10"
                   Visibility="Collapsed"/>
                
                <Button x:Name="ConfirmButton"
                        Content="Confirm"
                        Height="35"
                        Margin="0,0,0,10"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ConfirmButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#1ABC9C"/>
                    </Button.Background>
                </Button>

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Height="35"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="CancelButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#95A5A6"/>
                    </Button.Background>
                </Button>
            </StackPanel>

            
            <StackPanel x:Name="SuccessContent" Visibility="Collapsed" Background="Transparent">
                <TextBlock Text="✓ Transfer Successful!"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF1ABC9C"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,10"/>
                <TextBlock x:Name="SuccessText"
                           FontSize="14"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
