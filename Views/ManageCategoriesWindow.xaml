<Window x:Class="SmartSaving.Views.ManageCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Budget Limits" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize"
        Icon="/Assets/Icono.ico">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Manage Budget Limits"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <TextBlock Text="&#xe8d1;"
               FontFamily="Segoe MDL2 Assets"
               FontSize="30"
               Foreground="Orange"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFE74C3C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, 
                           Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="#FF27AE60"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="{Binding SuccessMessage, 
                           Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Categories List -->
                <Border Background="#334155" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding ExpenseCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="Monthly Budget Limit (leave empty for no limit)"
                                               Foreground="#FFBDC3C7"
                                               FontSize="11"
                                               Margin="0,0,0,4"/>
                                    <TextBox Background="#FFECF0F1"
                                             Padding="5"
                                             Text="{Binding BudgetLimit, 
                                             UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Save Button -->
                <Button Content="Save Changes"
                        Height="35"
                        Background="#FF1ABC9C"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding SaveCommand}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
