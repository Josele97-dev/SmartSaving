<Window x:Class="SmartSaving.Views.BudgetWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Warning" Height="380" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel>

            <!-- Warning Icon and Title -->
            <TextBlock Text="⚠ Budget Limit Exceeded"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FFF39C12"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Buttons -->
            <Button Content="Proceed Anyway"
                    Height="35"
                    Margin="0,0,0,10"
                    Background="#FFE74C3C"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="ProceedButton_Click"/>

            <Button Content="Update Budget Limit"
                    Height="35"
                    Margin="0,0,0,10"
                    Background="#FF8E44AD"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="UpdateLimitButton_Click"/>

            <Button Content="Cancel"
                    Height="35"
                    Background="#FF95A5A6"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
