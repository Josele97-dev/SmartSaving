<Window x:Class="SmartSaving.Views.BudgetWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Budget Warning" Height="380" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize"
        Icon="/Assets/Icono.ico">

    <Grid Margin="30">
        <StackPanel>
            
            <StackPanel x:Name="WarningContent">
                <TextBlock Text="⚠ Budget Limit Exceeded"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FFF39C12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

                <TextBlock x:Name="MessageText"
                   Foreground="White"
                   FontSize="13"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>

                <Button x:Name="ProceedButton"
                Content="Proceed Anyway"
                Height="35"
                Margin="0,0,0,10"
                Foreground="White"
                FontWeight="Bold"
                Click="ProceedButton_Click">
                            <Button.Background>
                                <SolidColorBrush Color="#E74C3C"/>
                            </Button.Background>
                        </Button>

                <Button x:Name="UpdateLimitButton"
                Content="Update Budget Limit"
                Height="35"
                Margin="0,0,0,10"
                Foreground="White"
                FontWeight="Bold"
                Click="UpdateLimitButton_Click">    
                    <Button.Background>
                        <SolidColorBrush Color="#8E44AD"/>
                    </Button.Background>
                </Button>
                <Button x:Name="CancelButton"
                Content="Cancel"
                Height="35"
                Foreground="White"
                FontWeight="Bold"
                Click="CancelButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#95A5A6"/>
                    </Button.Background>
                </Button>

            </StackPanel>

            
            <StackPanel x:Name="SuccessContent" Visibility="Collapsed">
                <TextBlock Text="⚠ Transaction saved"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FFF39C12"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,10"/>
                <TextBlock Text="Budget limit has been exceeded!"
                   FontSize="14"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
