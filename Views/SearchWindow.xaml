<Window x:Class="SmartSaving.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Transactions" Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#1E293B"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Search Transactions"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Search Form -->
                <Border Background="#334155" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                    <StackPanel>

                        <!-- Keyword -->
                        <TextBlock Text="Keyword" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox Background="#FFECF0F1"
                                 Padding="5"
                                 Margin="0,0,0,10"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Content="Starts with"
                             Foreground="White"
                             Margin="0,0,15,0"
                             IsChecked="{Binding SearchStartsWith}"/>
                            
                            <RadioButton Content="Contains"
                             Foreground="White"
                             IsChecked="{Binding SearchContains}"/>
                            
                        </StackPanel>
                        <!-- Transaction Type -->
                       
                        <TextBlock Text="Transaction Type" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox Background="#FFECF0F1"
                                  Padding="5"
                                  Margin="0,0,0,10"
                                  ItemsSource="{Binding TransactionTypes}"
                                  SelectedItem="{Binding SelectedType}"/>

                        <!-- Category -->
                        <TextBlock Text="Category" Foreground="White" Margin="0,0,0,4"/>
                        <ComboBox Background="#FFECF0F1"
                          Padding="5"
                          Margin="0,0,0,10"
                          ItemsSource="{Binding Categories}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" Foreground="Black"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>    
                        </ComboBox>

                        <!-- Date Range -->
                        <TextBlock Text="From Date" Foreground="White" Margin="0,0,0,4"/>
                        <DatePicker Background="#FFECF0F1"
                                    Margin="0,0,0,10"
                                    SelectedDate="{Binding FromDate}"/>

                        <TextBlock Text="To Date" Foreground="White" Margin="0,0,0,4"/>
                        <DatePicker Background="#FFECF0F1"
                                    Margin="0,0,0,15"
                                    SelectedDate="{Binding ToDate}"/>

                        <!-- Search Button -->
                        <Button Content="Search"
                                Height="35"
                                Background="#FF3498DB"
                                Foreground="White"
                                FontWeight="Bold"
                                Command="{Binding SearchCommand}"/>

                    </StackPanel>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFE74C3C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage,
                           Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Results -->
                <TextBlock Text="Results"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Border Background="#334155" CornerRadius="8" Padding="5" MinHeight="100">
                    <ListView ItemsSource="{Binding Results}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              SelectedItem="{Binding SelectedTransaction}"
                              MouseDoubleClick="ListView_MouseDoubleClick"
                              >
                        
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF1A2F3E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF2A4A5E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" Width="85"
                                                DisplayMemberBinding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                <GridViewColumn Header="Description" Width="130"
                                                DisplayMemberBinding="{Binding Description}"/>
                                <GridViewColumn Header="Amount" Width="80"
                                                DisplayMemberBinding="{Binding Amount, StringFormat='€{0:N2}'}"/>
                                <GridViewColumn Header="Category" Width="90"
                                                DisplayMemberBinding="{Binding Category.Title}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
